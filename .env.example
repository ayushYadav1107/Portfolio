# Public URL of the deployed site (SEO, sitemap, link previews)
NEXT_PUBLIC_SITE_URL=https://ayushyadav.vercel.app

# Contact form — get a key at https://resend.com
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/data/profile.ts).
# With the default onboarding@resend.dev sender, this MUST be the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Sender; keep the default until you verify a domain in Resend
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
